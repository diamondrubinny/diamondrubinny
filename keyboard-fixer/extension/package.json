{
  "name": "keyflip-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Fixes text typed in the wrong keyboard layout (Hebrew/English).",
  "scripts": {
    "test": "node --test --experimental-strip-types tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "e2e": "node tests/e2e.cjs",
    "eval": "node --experimental-strip-types scripts/eval.ts"
  },
  "devDependencies": {
    "@types/chrome": "0.0.287",
    "@types/node": "^22.20.5",
    "esbuild": "0.24.0",
    "typescript": "5.6.3"
  }
}
